# ==============================================================
# VARIABLES DE ENTORNO - PORTAL AGENTE IA BANCO NOVATERRA
# Copiar este archivo a .env antes de levantar en producción:
#   cp .env.example .env
# ==============================================================

# Clave de API oficial de Cohere (Indispensable para embeddings y LLM Command R)
COHERE_API_KEY=tu_api_key_de_cohere_aqui

# Configuración de puertos de host (Alineados para convivir con VentasFix)
# VentasFix usa 80, 443, 8080 y 3306.
# Novaterra usa 3000 (Frontend) y 8001 (Backend API).
FRONTEND_PORT=3000
BACKEND_PORT=8001

# URL base de la API para el build del Frontend
# Dejar vacío para usar rutas relativas (/api) con el proxy inverso de Nginx
VITE_API_URL=
